# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID de la aplicación (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID del servidor (Discord) donde se probaran/registraran los comandos.
# Dejalo vacio para registrar los comandos de forma global (tarda hasta 1h en propagarse).
GUILD_ID=

# IDs de los roles de staff que tienen acceso a los tickets, separados por coma
STAFF_ROLE_IDS=

# ID de la categoria de Discord donde se crean los canales de ticket.
# Si la dejas vacia, el bot busca/crea una categoria llamada "🎫 Tickets".
TICKET_CATEGORY_ID=

# Canal donde se postea el feedback (1-5 estrellas) al cerrar un ticket
FEEDBACK_CHANNEL_ID=

# Canal donde se postean las sugerencias enviadas por el formulario
SUGGESTIONS_LOG_CHANNEL_ID=
